{
  "openapi": "3.0.3",
  "info": {
    "title": "Libris circulation test contract",
    "version": "0.1.0",
    "description": "Team-authored contract for selected write endpoints; refer to source and README for limitations."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8080"
    }
  ],
  "paths": {
    "/api/borrow-records": {
      "post": {
        "operationId": "borrowItem",
        "summary": "Borrow exactly one item for a student",
        "description": "ADMIN or LIBRARIAN. Exactly one of bookId, magazineId and newspaperId must be non-null; referenced records must exist and item must be available. Due date defaults to borrow date plus 14 days. Malformed JSON and invalid body values return a structured 400 INVALID_REQUEST.",
        "security": [
          {
            "sessionCookie": [],
            "csrfHeader": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BorrowRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created",
            "headers": {
              "Location": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BorrowRecord"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request body, validation, or business rule; structured ApiError response.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "401": {
            "description": "Application or security error; response body depends on handler.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "403": {
            "description": "Application or security error; response body depends on handler.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "404": {
            "description": "Application or security error; response body depends on handler.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "409": {
            "description": "Application or security error; response body depends on handler.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "500": {
            "description": "Application or security error; response body depends on handler.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/api/borrow-records/{id}/return": {
      "post": {
        "operationId": "returnItem",
        "summary": "Return an active borrow record",
        "description": "ADMIN or LIBRARIAN. Repeated return is rejected. A non-numeric ID returns a structured 400 INVALID_ARGUMENT.",
        "security": [
          {
            "sessionCookie": [],
            "csrfHeader": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Returned"
          },
          "400": {
            "description": "Invalid path argument or business rule; structured ApiError response.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "401": {
            "description": "Application or security error; response body depends on handler.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "403": {
            "description": "Application or security error; response body depends on handler.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "404": {
            "description": "Application or security error; response body depends on handler.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "409": {
            "description": "Application or security error; response body depends on handler.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "500": {
            "description": "Application or security error; response body depends on handler.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "sessionCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "JSESSIONID"
      },
      "csrfHeader": {
        "type": "apiKey",
        "in": "header",
        "name": "X-XSRF-TOKEN"
      }
    },
    "schemas": {
      "BorrowRequest": {
        "type": "object",
        "required": [
          "studentId",
          "borrowDate"
        ],
        "properties": {
          "bookId": {
            "type": "integer",
            "format": "int64",
            "nullable": true
          },
          "magazineId": {
            "type": "integer",
            "format": "int64",
            "nullable": true
          },
          "newspaperId": {
            "type": "integer",
            "format": "int64",
            "nullable": true
          },
          "studentId": {
            "type": "integer",
            "format": "int64",
            "nullable": false
          },
          "borrowerName": {
            "type": "string",
            "nullable": true,
            "description": "Accepted by DTO but ignored; borrower details come from the student profile."
          },
          "borrowerEmail": {
            "type": "string",
            "nullable": true,
            "description": "Accepted by DTO but ignored; borrower details come from the student profile."
          },
          "borrowerPhone": {
            "type": "string",
            "nullable": true,
            "description": "Accepted by DTO but ignored; borrower details come from the student profile."
          },
          "borrowDate": {
            "type": "string",
            "format": "date",
            "nullable": false
          },
          "dueDate": {
            "type": "string",
            "format": "date",
            "nullable": true
          }
        },
        "description": "One item identifier must be non-null (BR-C01); identifiers are resolved in persistent storage.",
        "x-non-null-count": {
          "fields": [
            "bookId",
            "magazineId",
            "newspaperId"
          ],
          "minimum": 1,
          "maximum": 1
        }
      },
      "BorrowRecord": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "itemId": {
            "type": "integer",
            "format": "int64",
            "nullable": true
          },
          "itemTitle": {
            "type": "string",
            "nullable": true
          },
          "itemType": {
            "type": "string",
            "nullable": true
          },
          "studentId": {
            "type": "integer",
            "format": "int64"
          },
          "borrowerName": {
            "type": "string",
            "nullable": true
          },
          "borrowerEmail": {
            "type": "string",
            "nullable": true
          },
          "borrowerPhone": {
            "type": "string",
            "nullable": true
          },
          "borrowDate": {
            "type": "string",
            "format": "date",
            "nullable": true
          },
          "dueDate": {
            "type": "string",
            "format": "date",
            "nullable": true
          },
          "returnDate": {
            "type": "string",
            "format": "date",
            "nullable": true
          },
          "status": {
            "type": "string",
            "enum": [
              "BORROWED",
              "RETURNED"
            ]
          },
          "daysOverdue": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "ApiError": {
        "type": "object",
        "properties": {
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "status": {
            "type": "integer"
          },
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "fieldErrors": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "field": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  }
}
